# Nombre: .env.example
# Descripción: Variables de AccesIA sin claves. infra/scripts/generar-env.ps1 (o .sh) crea infra/.env con claves nuevas.
# Fecha de creación: 2026-11-11
# Actualización: 2026-11-19
# Autor: Equipo AccesIA
# Versión: 1.2
#
# infra/.env no se sube a Git. Las claves vacías las llena generar-env con valores aleatorios.
# Explicación de cada variable: specs/arquitectura.md, sección Configuración.

# PostgreSQL (nunca el 5432 en el PC; si Windows reservó este puerto, elige otro: infra/README.md)
POSTGRES_PORT=5434
POSTGRES_DB=accesia
POSTGRES_USER=accesia
POSTGRES_PASSWORD=
AGENTE_DB_PASSWORD=

# Web de administración
SESION_SECRETO=
ADMIN_CORREO=admin@example.com
ADMIN_CLAVE_INICIAL=

# MQTT: usuarios servidor, homeassistant y camara
MQTT_SERVIDOR_CLAVE=
MQTT_HA_CLAVE=
MQTT_CAMARA_CLAVE=

# Reglas (specs/reglas.md); se cambian aquí y se reinicia el servidor (D-14)
UMBRAL_SIMILITUD=0.363
VENTANA_REPETIDO_S=60
ALERTA_DESCONOCIDOS=3
ALERTA_VENTANA_S=60
INSCRIPCION_MUESTRAS=5
INSCRIPCION_VENCE_S=120
CARA_MIN_PX=80
NITIDEZ_MIN=60
ZONA_HORARIA=America/Bogota

# Agente (D-06)
OLLAMA_MODELO=qwen2.5:3b
# Servidor MCP: encabezados Host que acepta además de mcp:8001, separados por comas. En el escenario 2 (D-21),
# la IP del portátil en el hotspot; si el portátil queda en otra, se cambia aquí.
MCP_HOSTS_PERMITIDOS=192.168.137.1:8001
# Plan B con el broker de la Pi (D-23): la IP de la Pi en el hotspot, para infra/compose.broker-pi.yaml.
# Si en clase la Pi queda en otra IP (P-04), se cambia aquí.
IP_DE_LA_PI=192.168.137.250
