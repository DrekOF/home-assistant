{
  "name": "accesia-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web de administración de AccesIA (frente C).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:simulacro": "vite --mode simulacro",
    "tipos": "openapi-typescript ../specs/contratos/openapi.yaml -o src/api/esquema.d.ts --default-non-nullable false",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:servidor": "playwright test --config playwright.servidor.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.72.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "msw": "3.0.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}