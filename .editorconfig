# Nombre: .editorconfig
# Descripción: Formato común de los archivos de AccesIA en cualquier editor.
# Fecha de creación: 2026-11-11
# Actualización: 2026-11-11
# Autor: Equipo AccesIA
# Versión: 1.1

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{py,c,cpp,h,hpp}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 lee como ANSI los .ps1 sin BOM y daña las tildes.
# Los .bat van sin BOM: cmd.exe no lo entiende.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

[*.bat]
end_of_line = crlf
