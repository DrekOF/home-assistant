# Nombre: sdkconfig.defaults.esp32c6
# Descripción: Configuración de la XIAO ESP32-C6 (D-21): 4 MB de flash y sin PSRAM. ESP-IDF la suma a sdkconfig.defaults.
# Fecha de creación: 2026-11-12
# Actualización: 2026-11-12
# Autor: Equipo AccesIA
# Versión: 1.0

# CPU a 160 MHz, lo más que da el ESP32-C6.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
